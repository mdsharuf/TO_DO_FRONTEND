"fetch","then","res","json","data","addTask","method","headers","body","JSON","stringify","newTask","toggleTask","id","concat","map","task","_objectSpread","completed","deleteTask","filter","style","padding","children","value","onChange","e","target","placeholder","onClick","textDecoration","cursor","root","createRoot","document","getElementById","render"],"sources":["/home/mohammed-sharuf/Backend/Frontend/src/index.js"],"sourcesContent":["import React, { useEffect, useState } from \"react\";\nimport ReactDOM from \"react-dom/client\";\n\nfunction App() {\n  const [tasks, setTasks] = useState([]);\n  const [title, setTitle] = useState(\"\");\n\n  useEffect(() => {\n    fetch(\"http://13.233.85.25:5000/tasks\")\n      .then(res => res.json())\n      .then(data => setTasks(data));\n  }, []);\n\n  const addTask = () => {\n    fetch(\"http://13.233.85.25:5000/tasks\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ title })\n    })\n    .then(res => res.json())\n    .then(newTask => setTasks([...tasks, newTask]));\n    setTitle(\"\");\n  };\n\n  const toggleTask = (id) => {\n    fetch(`http://13.233.85.25:5000/tasks/${id}`, { method: \"PUT\" })\n      .then(() => {\n        setTasks(tasks.map(task =>\n          task.id === id ? { ...task, completed: !task.completed } : task\n        ));\n      });\n  };\n\n  const deleteTask = (id) => {\n    fetch(`http://13.233.85.25:5000/tasks/${id}`, { method: \"DELETE\" })\n      .then(() => setTasks(tasks.filter(task => task.id !== id)));\n  };\n\n  return (\n    <div style={{ padding: \"20px\" }}>\n      <h1>Todo App</h1>\n      <input\n        value={title}\n        onChange={(e) => setTitle(e.target.value)}\n        placeholder=\"Add task...\"\n      />\n      <button onClick={addTask}>Add</button>\n      <ul>\n        {tasks.map(task => (\n          <li key={task.id}>\n            <span\n              onClick={() => toggleTask(task.id)}\n              style={{\n                textDecoration: task.completed ? \"line-through\" : \"none\",\n                cursor: \"pointer\"\n              }}\n            >\n              {task.title}\n            </span>\n            <button onClick={() => deleteTask(task.id)}>❌</button>\n          </li>\n        ))}\n      </ul>\n    </div>\n  );\n}\n\nconst root = ReactDOM.createRoot(document.getElementById(\"root\"));\nroot.render(<App />);\n\n"],"mappings":"2HAAA,MAAO,CAAAA,KAAK,EAAIC,SAAS,CAAEC,QAAQ,KAAQ,OAAO,CAClD,MAAO,CAAAC,QAAQ,KAAM,kBAAkB,CAAC,OAAAC,GAAA,IAAAC,IAAA,CAAAC,IAAA,IAAAC,KAAA,yBAExC,QAAS,CAAAC,GAAGA,CAAA,CAAG,CACb,KAAM,CAACC,KAAK,CAAEC,QAAQ,CAAC,CAAGR,QAAQ,CAAC,EAAE,CAAC,CACtC,KAAM,CAACS,KAAK,CAAEC,QAAQ,CAAC,CAAGV,QAAQ,CAAC,EAAE,CAAC,CAEtCD,SAAS,CAAC,IAAM,CACdY,KAAK,CAAC,gCAAgC,CAAC,CACpCC,IAAI,CAACC,GAAG,EAAIA,GAAG,CAACC,IAAI,CAAC,CAAC,CAAC,CACvBF,IAAI,CAACG,IAAI,EAAIP,QAAQ,CAACO,IAAI,CAAC,CAAC,CACjC,CAAC,CAAE,EAAE,CAAC,CAEN,KAAM,CAAAC,OAAO,CAAGA,CAAA,GAAM,CACpBL,KAAK,CAAC,gCAAgC,CAAE,CACtCM,MAAM,CAAE,MAAM,CACdC,OAAO,CAAE,CAAE,cAAc,CAAE,kBAAmB,CAAC,CAC/CC,IAAI,CAAEC,IAAI,CAACC,SAAS,CAAC,CAAEZ,KAAM,CAAC,CAChC,CAAC,CAAC,CACDG,IAAI,CAACC,GAAG,EAAIA,GAAG,CAACC,IAAI,CAAC,CAAC,CAAC,CACvBF,IAAI,CAACU,OAAO,EAAId,QAAQ,CAAC,CAAC,GAAGD,KAAK,CAAEe,OAAO,CAAC,CAAC,CAAC,CAC/CZ,QAAQ,CAAC,EAAE,CAAC,CACd,CAAC,CAED,KAAM,CAAAa,UAAU,CAAIC,EAAE,EAAK,CACzBb,KAAK,mCAAAc,MAAA,CAAmCD,EAAE,EAAI,CAAEP,MAAM,CAAE,KAAM,CAAC,CAAC,CAC7DL,IAAI,CAAC,IAAM,CACVJ,QAAQ,CAACD,KAAK,CAACmB,GAAG,CAACC,IAAI,EACrBA,IAAI,CAACH,EAAE,GAAKA,EAAE,CAAAI,aAAA,CAAAA,aAAA,IAAQD,IAAI,MAAEE,SAAS,CAAE,CAACF,IAAI,CAACE,SAAS,GAAKF,IAC7D,CAAC,CAAC,CACJ,CAAC,CAAC,CACN,CAAC,CAED,KAAM,CAAAG,UAAU,CAAIN,EAAE,EAAK,CACzBb,KAAK,mCAAAc,MAAA,CAAmCD,EAAE,EAAI,CAAEP,MAAM,CAAE,QAAS,CAAC,CAAC,CAChEL,IAAI,CAAC,IAAMJ,QAAQ,CAACD,KAAK,CAACwB,MAAM,CAACJ,IAAI,EAAIA,IAAI,CAACH,EAAE,GAAKA,EAAE,CAAC,CAAC,CAAC,CAC/D,CAAC,CAED,mBACEnB,KAAA,QAAK2B,KAAK,CAAE,CAAEC,OAAO,CAAE,MAAO,CAAE,CAAAC,QAAA,eAC9B/B,IAAA,OAAA+B,QAAA,CAAI,UAAQ,CAAI,CAAC,cACjB/B,IAAA,